# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
# Full connection string, e.g. postgres://user:password@localhost:5432/glitrai
DATABASE_URL=postgres://postgres:postgres@localhost:5432/glitrai

# ---- LLM (prompt generation) ----
# Free tier options that work with the OpenAI-compatible client below:
#   Groq        -> https://console.groq.com  (fast, generous free tier, recommended)
#   OpenAI      -> https://platform.openai.com
# Leave LLM_API_KEY empty to fall back to a deterministic local template
# (the app still works fully end-to-end with zero keys configured).
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# ---- Image generation ----
# freeapi  -> (default, recommended) real text-to-image generation via a free,
#             keyless API (Pollinations.ai), using the LLM-generated prompt.
#             Produces a genuinely NEW image, not the original photo with text
#             on it. Falls back to "mock" automatically if the call fails
#             (offline dev environment, endpoint down, etc).
# comfyui  -> forwards the prompt + reference image to a running ComfyUI
#             instance for real img2img + upscale that preserves the exact
#             product appearance (Assignment 2). Falls back to freeapi, then
#             mock, on failure.
# mock     -> skips all network calls; composites the uploaded reference photo
#             with the prompt text locally using sharp. Useful for fully
#             offline development.
IMAGE_GEN_MODE=freeapi

# Only needed when IMAGE_GEN_MODE=comfyui — this is the optional Assignment 2
# integration, not required for Assignment 1 on its own.
COMFYUI_URL=
# Path to workflow_img2img_upscale.json. Already included in this project at
# comfyui/workflow_img2img_upscale.json (sibling of backend/) — point this at
# that file (or your own updated copy) once you have ComfyUI running.
COMFYUI_WORKFLOW_PATH=../comfyui/workflow_img2img_upscale.json
